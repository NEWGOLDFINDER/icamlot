[Unit]
Description=ICAM LOT - API des stratégies du programmeur de match
After=network.target

[Service]
User=icamlot
Group=icamlot
Environment=ICAMLOT_DATA=/var/lib/icamlot/strategies
# ICAMLOT_PASSWORD=<mot de passe d'équipe> : écrit par deploy/install.sh, jamais dans le dépôt.
EnvironmentFile=-/etc/icamlot/api.env
ExecStart=/usr/bin/python3 /opt/icamlot/api/server.py --host 127.0.0.1 --port 8081
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/icamlot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
